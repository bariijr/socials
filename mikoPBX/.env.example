# ─────────────────────────────────────────────────────────────────────────────
# MikoPBX — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PROJECT ──────────────────────────────────────────────
PROJECT_SLUG=mikopbx
APP_ENV=production

# ── SERVER ───────────────────────────────────────────────
# Public IP of the VPS (used to bind SIP/RTP ports to the correct interface)
HOST_IP=107.174.35.100
TZ=Africa/Dar_es_Salaam
HOSTNAME=hub.insider.co.tz

# ── MIKOPBX WEB ADMIN ───────────────────────────────────
# NPM proxy host: pbx.insider.co.tz → 107.174.35.100:4000
MIKOPBX_DOMAIN=pbx.insider.co.tz

# ── MIKOPBX SSH ──────────────────────────────────────────
# MikoPBX built-in SSH console — bound to localhost only
MIKOPBX_SSH_PORT=2222

# ── SIP CONFIGURATION ────────────────────────────────────
# SIP signaling ports (must match MikoPBX admin settings)
SIP_UDP_PORT=5060
SIP_TCP_PORT=5060
SIPS_TLS_PORT=5061

# ── RTP MEDIA ────────────────────────────────────────────
# RTP port range — must match MikoPBX → Network → RTP ports settings
RTP_PORT_FROM=10000
RTP_PORT_TO=10200

# ── NAT / EXTERNAL IP ────────────────────────────────────
# Required in MikoPBX admin → Network → External IP
# Set this to your VPS public IP for correct SIP/RTP NAT traversal
EXTERNAL_IP=107.174.35.100

# ── BACKUP ───────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
