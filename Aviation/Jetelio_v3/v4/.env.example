# Copy to .env and fill in. No secrets are committed.

# --- Postgres ---
POSTGRES_USER=jetelio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jetelio_v4
DB_HOST_PORT=15432

# --- MinIO (S3-compatible object storage for documents/PDFs) ---
MINIO_ROOT_USER=jetelio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_CONSOLE_PORT=19001
S3_BUCKET_DOCUMENTS=jetelio-documents
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Mail (dev = mailhog, prod = real SMTP relay) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ops@jetelio.local
MAILHOG_UI_PORT=18025

# --- App / API ---
ENV=development
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=*
BASE_URL=http://localhost:8080

# --- Front door ---
NEXT_PUBLIC_API_BASE_URL=/api
HTTP_PORT=8080

# --- Named settings defaults (also seeded into the settings table; env only overrides seed) ---
DEFAULT_PERMIT_LEAD_TIME_HOURS=72
DEFAULT_GROUND_NOTICE_HOURS=24
RANGE_RESERVE_MARGIN=0.15
PASSPORT_VALIDITY_BUFFER_DAYS=180
DOCUMENT_EXPIRY_ALERT_DAYS=180,90,30,7
VISA_RULE_STALENESS_DAYS=365
ALLOW_UNVERIFIED_FOR_PLANNING=NO

# --- Importer ---
IMPORT_SOURCE_XLSX=/app/data/JTLlayout-Index_admin.xlsx

# --- Chatbot trip-builder — user's own DeepSeek key, never committed ---
DEEPSEEK_API_KEY=
