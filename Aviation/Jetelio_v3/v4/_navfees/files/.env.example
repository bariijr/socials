# Jetelio Navigation Fee Calculator - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# ============================================================================
# CORS Configuration (for Jetelio v4 frontend)
# ============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://jetelio.app"]

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://jetelio:password@localhost:5432/jetelio_nav

# ============================================================================
# Jetelio Integration
# ============================================================================
# Main Jetelio v4 API base URL
JETELIO_API_BASE=http://localhost:8001

# API authentication
JETELIO_API_KEY=dev-key-replace-in-production

# Jetelio platform margin on nav fees (percentage)
JETELIO_MARGIN_PERCENT=15.0

# ============================================================================
# Wind Data & Weather Services
# ============================================================================
# Open-Meteo API key (leave empty for free tier)
OPENMETEO_API_KEY=

# Enable wind-optimized routing calculations
ENABLE_WIND_OPTIMIZATION=True

# ============================================================================
# Data Sources
# ============================================================================
# Path to Excel file containing ANS provider fee data
EXCEL_DATA_PATH=./data/ans_providers.xlsx

# Path to GeoJSON file containing FIR boundaries
FIR_GEOJSON_PATH=./data/fir_boundaries.geojson

# Use PostGIS for FIR geometry queries (set to True if PostgreSQL has PostGIS)
USE_POSTGIS=False

# ============================================================================
# Fee Calculation Defaults
# ============================================================================
# Currency for fee calculations
DEFAULT_CURRENCY=USD

# VAT/GST rate to apply to fees (as percentage, e.g., 20 for 20% VAT)
VAT_RATE_PERCENT=0.0

# ============================================================================
# Caching
# ============================================================================
# Enable response caching
ENABLE_CACHE=True

# Cache TTL in seconds (1 hour = 3600)
CACHE_TTL_SECONDS=3600

# ============================================================================
# Rate Limiting
# ============================================================================
# Enable rate limiting per IP
ENABLE_RATE_LIMITING=True

# Requests allowed per minute per IP
REQUESTS_PER_MINUTE=60
